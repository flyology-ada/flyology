project Flyology_Bench_Docs is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Source_Files use
     ("flyology_bench.ads",
      "flyology_bench-baselines.ads",
      "flyology_bench-host_control.ads",
      "flyology_bench-metadata.ads",
      "flyology_bench-recording.ads",
      "flyology_bench-recording-reporters.ads",
      "flyology_bench-reporters.ads",
      "flyology_bench-scaling.ads",
      "flyology_bench-sweeps.ads",
      "flyology_bench-sweeps-reporters.ads",
      "flyology_bench-suites.ads");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";

   package Documentation is
      for Resources_Dir ("html") use "../docs/gnatdoc-bench/html";
   end Documentation;
end Flyology_Bench_Docs;
