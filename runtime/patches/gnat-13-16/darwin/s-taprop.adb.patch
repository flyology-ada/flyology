-      Time    : Duration;
-      Mode    : ST.Delay_Modes) renames Monotonic.Timed_Delay;
+   procedure Timed_Delay
+     (Self_ID : Task_Id;
+      Time    : Duration;
+      Mode    : ST.Delay_Modes)
+   is
+      Deadline     : Duration;
+      Lightweight_Result : aliased Interfaces.C.int;
+      Result       : Interfaces.C.int;
+   begin
+      if not Is_Lightweight_Task (Self_ID) then
+         Monotonic.Timed_Delay (Self_ID, Time, Mode);
+         return;
+      end if;
+
+      Write_Lock (Self_ID);
+      Deadline := Lightweight_Deadline (Time, Mode);
+
+      if Deadline > Monotonic.Monotonic_Clock
+        and then Self_ID.Pending_ATC_Level >= Self_ID.ATC_Nesting_Level
+      then
+         Self_ID.Common.State := Delay_Sleep;
+         loop
+            Result :=
+              Lightweight_Sleep
+                (Self_ID.Common.LL.L'Address,
+                 Deadline,
+                 Lightweight_Result'Access);
+            if Result /= 0 then
+               raise Program_Error with "Flyology timed delay failed";
+            end if;
+            exit when Lightweight_Result /= 0
+              or else Self_ID.Pending_ATC_Level < Self_ID.ATC_Nesting_Level;
+         end loop;
+         Self_ID.Common.State := Runnable;
+      end if;
+
+      Unlock (Self_ID);
+      Result := Lightweight_Yield;
+      if Result /= 0 then
+         raise Program_Error with "Flyology delay yield failed";
+      end if;
+   end Timed_Delay;
+
+   function Lightweight_Deadline
+     (Time : Duration; Mode : ST.Delay_Modes) return Duration
+   is
+      Now : constant Duration := Monotonic.Monotonic_Clock;
+   begin
+      if Mode = Relative then
+         return Duration'Min (Time, Max_Sensible_Delay) + Now;
+         pragma Warnings (Off);
+      elsif Mode = Absolute_RT
+        or else OSC.CLOCK_RT_Ada = OSC.CLOCK_REALTIME
+      then
+         pragma Warnings (On);
+         return Duration'Min (Now + Max_Sensible_Delay, Time);
+      else
+         return Duration'Min
+           (Now + Max_Sensible_Delay,
+            Time + Now - OS_Primitives.Clock);
+      end if;
+   end Lightweight_Deadline;
