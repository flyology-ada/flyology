+        and then
+          (CPU < Integer (System.Multiprocessors.CPU_Range'First)
+           or else CPU > Integer (System.Multiprocessors.CPU_Range'Last)
+           or else
+             (not Is_Lightweight
+              and then CPU > Integer (System.Multiprocessors.Number_Of_CPUs)))
@@ -653,1 +659,2 @@
