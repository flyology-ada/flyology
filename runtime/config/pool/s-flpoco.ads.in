package System.Flyology.Pool_Config is
   pragma Preelaborate;

   --  Generated by prepare-rts.sh from validated build-time settings.  The
   --  scheduler uses this value when FLYOLOGY_LOOP_POOL_SIZE is absent at
   --  process startup. Keep this unit scalar-only: configuration queries must
   --  preserve lazy event-loop startup.
   Prepared_Pool_Size : constant Positive := @AUTOMATIC_POOL_SIZE@;
end System.Flyology.Pool_Config;
