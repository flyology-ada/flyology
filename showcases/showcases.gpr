with "../gnatevl.gpr";

project Showcases is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("evented_io.adb",
      "evented_pipeline.adb",
      "evented_vs_threads.adb",
      "hybrid_blocking_bridge.adb",
      "many_evented_tasks.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa");
   end Compiler;
end Showcases;
