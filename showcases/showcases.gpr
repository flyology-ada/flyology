with "../flyology.gpr";

project Showcases is
   type Build_Profile_Type is ("development", "release");
   Build_Profile : Build_Profile_Type :=
     external ("FLYOLOGY_SHOWCASE_PROFILE", "development");

   for Languages use ("Ada", "C");
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("cancellation_density.adb",
      "connection_density.adb",
      "connection_lifecycle.adb",
      "cooperative_fairness.adb",
      "dns_resolution.adb",
      "execution_groups.adb",
      "lightweight_file_io.adb",
      "lightweight_io.adb",
      "event_loop_pool.adb",
      "lightweight_pipeline.adb",
      "lightweight_vs_native.adb",
      "hybrid_blocking_bridge.adb",
      "http_server.adb",
      "http_benchmark_server.adb",
      "http_application_server.adb",
      "https_server.adb",
      "loop_thread_placement.adb",
      "many_lightweight_tasks.adb",
      "priority_scheduling.adb",
      "runtime_observability.adb",
      "stall_watchdog.adb",
      "structured_http.adb",
      "thread_per_core.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      case Build_Profile is
         when "development" =>
            for Default_Switches ("Ada") use
              ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwJ",
               "-gnateDFLYOLOGY_CONNECTION_TEST_HOOKS=False");
            for Default_Switches ("C") use ("-O2", "-Wall", "-Wextra");
         when "release" =>
            for Default_Switches ("Ada") use
              ("-gnat2022", "-O3", "-gnatwa", "-gnatwJ",
               "-gnateDFLYOLOGY_CONNECTION_TEST_HOOKS=False");
            for Default_Switches ("C") use ("-O3", "-Wall", "-Wextra");
      end case;
   end Compiler;
end Showcases;
