with "servletada_config";
with "servletada";
with "servletada_aws";

project ServletAda_AWS_App is
   for Main use ("servletada_app.adb");
   for Source_Dirs use ("src", "../servletada_common/src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";

   package Compiler renames ServletAda_Config.Compiler;
   package Binder renames ServletAda_Config.Binder;
end ServletAda_AWS_App;
