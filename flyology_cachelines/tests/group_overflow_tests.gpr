with "config/tests_config.gpr";
project Group_Overflow_Tests is

   for Source_Dirs use ("src_compile/", "src_negative/", "config/");
   for Object_Dir use "obj/group_overflow/" & Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use
     ("group_guard_compatibility.adb",
      "explicit_group_overflow.adb",
      "fitted_group_overflow.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Tests_Config.Ada_Compiler_Switches & ("-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Group_Overflow_Tests;
