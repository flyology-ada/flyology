with "supervision_lifecycle_conformance_flyology.gpr";
with "flyology_tla.gpr";

project Supervision_Lifecycle_Conformance is

   for Languages use ("Ada");
   for Source_Dirs use ("src", "generated", "..");
   for Object_Dir use "build/obj";
   for Exec_Dir use "bin";
   for Main use ("flyology-supervision-restart_window_conformance.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwJ", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Builder is
      for Executable ("flyology-supervision-restart_window_conformance.adb") use
        "supervision-lifecycle-conformance";
   end Builder;

end Supervision_Lifecycle_Conformance;
