with "guard_epoch_conformance_flyology.gpr";
with "flyology_tla.gpr";
project Guard_Epoch_Conformance is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "build/obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("flyology-data_structures-guard_epoch_conformance.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwJ", "-gnatyM110");
   end Compiler;
   package Builder is
      for Executable ("flyology-data_structures-guard_epoch_conformance.adb") use "guard-epoch-conformance";
   end Builder;
end Guard_Epoch_Conformance;
