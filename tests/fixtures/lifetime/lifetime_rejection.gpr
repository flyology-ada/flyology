with "../../../flyology.gpr";

--  Compile-only project for fixtures that must be rejected by the compiler.
--  It is never part of the behavioral suite; scripts/test.sh compiles it and
--  fails when a fixture is accepted.
project Lifetime_Rejection is
   for Source_Dirs use (".");
   for Object_Dir use "../../obj/lifetime_rejection";
   for Main use ("connection_outlives_server.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwJ");
   end Compiler;
end Lifetime_Rejection;
