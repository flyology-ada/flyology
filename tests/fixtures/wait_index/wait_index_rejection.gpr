with "../../../flyology.gpr";

--  Compile-only project for wait-set declarations that the public index
--  subtypes must reject. Out-of-range index bounds are diagnosed as warnings,
--  so this project promotes them to errors. scripts/test.sh compiles each
--  fixture and fails when the compiler accepts one.
project Wait_Index_Rejection is
   for Source_Dirs use (".");
   for Object_Dir use "../../obj/wait_index_rejection";
   for Main use
     ("oversized_wait_request_set.adb", "full_interrupt_set.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwe", "-gnatwJ");
   end Compiler;
end Wait_Index_Rejection;
