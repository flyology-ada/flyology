   function Decode_Input_Event
     (Source : String;
      Limits : Flyology_TLA.Traces.Load_Limits) return Input_Event_Type is
      pragma Unreferenced (Limits);
      Value : constant String := Flyology_TLA.Codecs.Decode_String (Source);
   begin
      if Value = "Finalize" then
         return Input_Event_Finalize;
      elsif Value = "DriverFinish" then
         return Input_Event_Driver_Finish;
      elsif Value = "DriverConsume" then
         return Input_Event_Driver_Consume;
      elsif Value = "DriverFinalize" then
         return Input_Event_Driver_Finalize;
      elsif Value = "DriverRaises" then
         return Input_Event_Driver_Raises;
      end if;
      raise Flyology_TLA.Codecs.Codec_Error with "unknown Input_Event literal";
   end Decode_Input_Event;

   function Encode_Input_Event (Item : Input_Event_Type) return String is
   begin
      return
        (case Item is
            when Input_Event_Finalize => """Finalize""",
            when Input_Event_Driver_Finish => """DriverFinish""",
            when Input_Event_Driver_Consume => """DriverConsume""",
            when Input_Event_Driver_Finalize => """DriverFinalize""",
            when Input_Event_Driver_Raises => """DriverRaises""");
   end Encode_Input_Event;

