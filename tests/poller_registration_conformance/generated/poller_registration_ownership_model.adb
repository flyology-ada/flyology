           (Flyology_TLA.Codecs.Object_Member (Source, "replacementDelivered", Limits), Limits),
         Arm_Suppressed => Decode_Outcome_Arm_Suppressed
           (Flyology_TLA.Codecs.Object_Member (Source, "armSuppressed", Limits), Limits),
         Descriptor_Generation => Decode_Outcome_Descriptor_Generation
           (Flyology_TLA.Codecs.Object_Member (Source, "descriptorGeneration", Limits), Limits),
         Stale_Link_Registered => Decode_Outcome_Stale_Link_Registered
           (Flyology_TLA.Codecs.Object_Member (Source, "staleLinkRegistered", Limits), Limits),
         Reuse_Kernel_Generation => Decode_Outcome_Reuse_Kernel_Generation
           (Flyology_TLA.Codecs.Object_Member (Source, "reuseKernelGeneration", Limits), Limits),
         Reused_Wait_Waiting => Decode_Outcome_Reused_Wait_Waiting
           (Flyology_TLA.Codecs.Object_Member (Source, "reusedWaitWaiting", Limits), Limits),
         Reused_Descriptor_Ready => Decode_Outcome_Reused_Descriptor_Ready
           (Flyology_TLA.Codecs.Object_Member (Source, "reusedDescriptorReady", Limits), Limits),
         Reused_Wait_Delivered => Decode_Outcome_Reused_Wait_Delivered
           (Flyology_TLA.Codecs.Object_Member (Source, "reusedWaitDelivered", Limits), Limits),
         Reuse_Arm_Suppressed => Decode_Outcome_Reuse_Arm_Suppressed
           (Flyology_TLA.Codecs.Object_Member (Source, "reuseArmSuppressed", Limits), Limits));
   end Decode_Outcome;

   function Encode_Outcome (Item : Outcome_Type) return String is
   begin
      return
        "{" &
        Flyology_TLA.Codecs.Encode_String ("pending") & ":"
        & Encode_Outcome_Pending (Item.Pending) & "," &
        Flyology_TLA.Codecs.Encode_String ("queued") & ":"
        & Encode_Outcome_Queued (Item.Queued) & "," &
        Flyology_TLA.Codecs.Encode_String ("foreignMutation") & ":"
        & Encode_Outcome_Foreign_Mutation (Item.Foreign_Mutation) & "," &
        Flyology_TLA.Codecs.Encode_String ("targetRunnable") & ":"
        & Encode_Outcome_Target_Runnable (Item.Target_Runnable) & "," &
        Flyology_TLA.Codecs.Encode_String ("targetReleased") & ":"
        & Encode_Outcome_Target_Released (Item.Target_Released) & "," &
        Flyology_TLA.Codecs.Encode_String ("kernelArmed") & ":"
        & Encode_Outcome_Kernel_Armed (Item.Kernel_Armed) & "," &
        Flyology_TLA.Codecs.Encode_String ("replacementWaiting") & ":"
        & Encode_Outcome_Replacement_Waiting (Item.Replacement_Waiting) & "," &
        Flyology_TLA.Codecs.Encode_String ("replacementDelivered") & ":"
        & Encode_Outcome_Replacement_Delivered (Item.Replacement_Delivered) & "," &
        Flyology_TLA.Codecs.Encode_String ("armSuppressed") & ":"
        & Encode_Outcome_Arm_Suppressed (Item.Arm_Suppressed) & "," &
        Flyology_TLA.Codecs.Encode_String ("descriptorGeneration") & ":"
        & Encode_Outcome_Descriptor_Generation (Item.Descriptor_Generation) & "," &
        Flyology_TLA.Codecs.Encode_String ("staleLinkRegistered") & ":"
        & Encode_Outcome_Stale_Link_Registered (Item.Stale_Link_Registered) & "," &
        Flyology_TLA.Codecs.Encode_String ("reuseKernelGeneration") & ":"
        & Encode_Outcome_Reuse_Kernel_Generation (Item.Reuse_Kernel_Generation) & "," &
        Flyology_TLA.Codecs.Encode_String ("reusedWaitWaiting") & ":"
        & Encode_Outcome_Reused_Wait_Waiting (Item.Reused_Wait_Waiting) & "," &
        Flyology_TLA.Codecs.Encode_String ("reusedDescriptorReady") & ":"
        & Encode_Outcome_Reused_Descriptor_Ready (Item.Reused_Descriptor_Ready) & "," &
        Flyology_TLA.Codecs.Encode_String ("reusedWaitDelivered") & ":"
        & Encode_Outcome_Reused_Wait_Delivered (Item.Reused_Wait_Delivered) & "," &
        Flyology_TLA.Codecs.Encode_String ("reuseArmSuppressed") & ":"
        & Encode_Outcome_Reuse_Arm_Suppressed (Item.Reuse_Arm_Suppressed) & "}";
   end Encode_Outcome;

   procedure Run
     (Self   : in out Adapter'Class;
      Trace  : Flyology_TLA.Traces.Trace;
      Limits : Flyology_TLA.Traces.Load_Limits;
      Result : out Flyology_TLA.Replay.Replay_Result)
   is
      use Ada.Strings.Unbounded;
      --  This private bridge is the only JSON-facing adapter layer.
      --  It decodes each command before calling the typed consumer.
      type Bridge is new Flyology_TLA.Replay.Adapter with null record;

      overriding procedure Reset
        (Ignored             : in out Bridge;
         Observed_State_JSON : out Unbounded_String;
         Status              : out Flyology_TLA.Replay.Adapter_Outcome);

      overriding procedure Apply
        (Ignored               : in out Bridge;
         Command               : Flyology_TLA.Replay.Replay_Command;
         Observed_Outcome_JSON : out Unbounded_String;
         Observed_State_JSON   : out Unbounded_String;
         Status                : out Flyology_TLA.Replay.Adapter_Outcome);

      procedure Reset
        (Ignored             : in out Bridge;
         Observed_State_JSON : out Unbounded_String;
         Status              : out Flyology_TLA.Replay.Adapter_Outcome)
      is
         pragma Unreferenced (Ignored);
         Observed : State_Type;
      begin
         Poller_Registration_Ownership_Model.Reset (Self, Observed, Status);
         if Status.Succeeded then
            Observed_State_JSON := To_Unbounded_String (Encode_State (Observed));
         else
            Observed_State_JSON := Null_Unbounded_String;
         end if;
      end Reset;

      procedure Apply
        (Ignored               : in out Bridge;
         Command               : Flyology_TLA.Replay.Replay_Command;
         Observed_Outcome_JSON : out Unbounded_String;
         Observed_State_JSON   : out Unbounded_String;
         Status                : out Flyology_TLA.Replay.Adapter_Outcome)
      is
         pragma Unreferenced (Ignored);
         Typed_Input   : Input_Type;
         Typed_Outcome : Outcome_Type;
         Typed_State   : State_Type;
      begin
         Typed_Input := Decode_Input (To_String (Command.Input_JSON), Limits);
         Poller_Registration_Ownership_Model.Apply
           (Self,
            Command.Index,
            To_String (Command.Action),
            To_String (Command.Role),
            Typed_Input,
            To_String (Command.Model_Source),
            Typed_Outcome,
            Typed_State,
            Status);
         if Status.Succeeded then
            Observed_Outcome_JSON := To_Unbounded_String (Encode_Outcome (Typed_Outcome));
            Observed_State_JSON := To_Unbounded_String (Encode_State (Typed_State));
         else
            Observed_Outcome_JSON := Null_Unbounded_String;
            Observed_State_JSON := Null_Unbounded_String;
         end if;
      exception
         when Error : Flyology_TLA.Codecs.Codec_Error | Constraint_Error =>
            Observed_Outcome_JSON := Null_Unbounded_String;
            Observed_State_JSON := Null_Unbounded_String;
            Status :=
              (Succeeded => False,
               Detail => To_Unbounded_String (Ada.Exceptions.Exception_Message (Error)));
      end Apply;

      Raw : Bridge;
   begin
      Flyology_TLA.Replay.Run (Raw, Trace, Limits, Result);
   end Run;

end Poller_Registration_Ownership_Model;
