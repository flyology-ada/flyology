with "../flyology.gpr";

project Runtime_Smoke is
   type Connection_Test_Hooks_Type is ("false", "true");
   Connection_Test_Hooks : Connection_Test_Hooks_Type :=
     external ("FLYOLOGY_CONNECTION_TEST_HOOKS", "false");
   Connection_Test_Hook_Switch :=
     "-gnateDFLYOLOGY_CONNECTION_TEST_HOOKS=False";
   case Connection_Test_Hooks is
      when "false" =>
         null;
      when "true" =>
         Connection_Test_Hook_Switch :=
           "-gnateDFLYOLOGY_CONNECTION_TEST_HOOKS=True";
   end case;

   for Languages use ("Ada", "C");
   for Source_Dirs use (".", "native");
   for Object_Dir use "obj/runtime_smoke";
   for Exec_Dir use "bin";
   for Main use
     ("accept_transient_smoke.adb",
      "cancellation_wake_smoke.adb",
      "connection_lifecycle_smoke.adb",
      "connection_state_model.adb",
      "descriptor_ownership_smoke.adb",
      "dns_smoke.adb",
      "dns_parser_smoke.adb",
      "default_policy_smoke.adb",
      "execution_groups_smoke.adb",
      "fault_injection_smoke.adb",
      "fairness_smoke.adb",
      "file_cancellation_smoke.adb",
      "files_smoke.adb",
      "flyology-counter_policy_smoke.adb",
      "io_smoke.adb",
      "io_starvation_smoke.adb",
      "lazy_event_start_smoke.adb",
      "lifecycle_smoke.adb",
      "linux_poller_fairness_smoke.adb",
      "loop_pool_smoke.adb",
      "loop_thread_placement_smoke.adb",
      "loop_thread_project_placement_smoke.adb",
      "observability_native_smoke.adb",
      "observability_smoke.adb",
      "priority_semantics_smoke.adb",
      "process_exit_live_task_smoke.adb",
      "process_exec_child_smoke.adb",
      "process_lifecycle_smoke.adb",
      "ready_queue_smoke.adb",
      "reap_finalize_race_smoke.adb",
      "runtime_smoke.adb",
      "semantic_conformance_matrix.adb",
      "stress_randomized.adb",
      "semantic_parity_smoke.adb",
      "stack_guard_smoke.adb",
      "stack_guard_violation_child.adb",
      "stack_size_parity_smoke.adb",
      "stack_pool_smoke.adb",
      "suspension_object_smoke.adb",
      "stall_watchdog_native_smoke.adb",
      "stall_watchdog_smoke.adb",
      "structured_server_smoke.adb",
      "structured_server_reuse_smoke.adb",
      "thread_affinity_smoke.adb",
      "timer_heap_smoke.adb",
      "topology_smoke.adb",
      "tls_smoke.adb",
      "tls_state_model.adb",
      "tcp_native_smoke.adb",
      "wait_any_smoke.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwJ",
         Connection_Test_Hook_Switch);
   end Compiler;
end Runtime_Smoke;
