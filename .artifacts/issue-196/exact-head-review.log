    Compiler_Release : Compiler_Release_Type :=
      Flyology_Atomic_Store_Config.Compiler_Release;
    Controlled_Subpool_Source_Dir := "controlled_subpools/corrected";
    case Compiler_Release is
       when "13.2.2" | "14.1.3" | "14.2.1" | "15.1.2" =>
          Controlled_Subpool_Source_Dir := "controlled_subpools/affected";
       when "15.3.1" | "16.1.0" | "16.2.0" =>
          null;
    end case;
 
    for Languages use ("Ada", "C");
    for Source_Dirs use (".", "native", Controlled_Subpool_Source_Dir);
