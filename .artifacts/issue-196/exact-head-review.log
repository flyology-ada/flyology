        or else Item.Stack_Cold
        or else Item.State /= Waiting
        or else Item.Timer_Index = 0
        or else Item.IO_Wait
        or else Item.File_Wait
        or else Item.Deadline - Clock < Item.Dormancy_Minimum_Wait
      then
         return;
      end if;

