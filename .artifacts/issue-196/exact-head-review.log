                      (Can_Migrate         => Item.Can_Migrate,
                       Target_Dedicated    => Target.Dedicated,
                       Target_Member_Count => Target_Member_Count,
                       Reservation_Matches => Reservation_Matches and then Item.Reserved_Group = Target)
