project Flyology_Allocators is
   for Source_Dirs use ("src/");
   for Library_Name use "flyology_allocators";
   for Object_Dir use
     external ("FLYOLOGY_ALLOCATORS_OBJECT_DIR", "obj");
   for Create_Missing_Dirs use "True";
   for Library_Dir use
     external ("FLYOLOGY_ALLOCATORS_LIBRARY_DIR", "lib");

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external
       ("FLYOLOGY_ALLOCATORS_LIBRARY_TYPE",
        external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;

end Flyology_Allocators;
