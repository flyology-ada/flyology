with "../../../flyology.gpr";

project Ada_Hosts_Spike is
   Rust_Library := external ("RUST_SPIKE_LIBRARY");
   Rust_Rpath   := external ("RUST_SPIKE_RPATH");

   for Languages use ("Ada");
   for Source_Dirs use ("ada");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build/bin";
   for Main use ("ada_hosts_spike.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwJ", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      for Switches ("ada_hosts_spike.adb") use (Rust_Library, Rust_Rpath);
   end Linker;
end Ada_Hosts_Spike;
