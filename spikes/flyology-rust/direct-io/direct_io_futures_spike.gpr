with "../../../flyology.gpr";

project Direct_IO_Futures_Spike is
   for Languages use ("Ada");
   for Source_Dirs use ("ada");
   for Object_Dir use "../../../build/spikes/direct_io/obj";
   for Exec_Dir use "../../../build/spikes/direct_io/bin";
   for Main use ("direct_io_futures_spike.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwJ", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      for Switches ("Ada") use (external ("FLYOLOGY_RUST_INTEREST_LIBRARY"));
   end Linker;

   package Format is
      for Width ("Ada") use "110";
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "2";
      for Indentation_Kind ("Ada") use "spaces";
      for End_Of_Line ("Ada") use "lf";
      for Charset ("Ada") use "utf-8";
   end Format;
end Direct_IO_Futures_Spike;
