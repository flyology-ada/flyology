   function Encode_Outcome_Chunk (Item : Outcome_Chunk_Type) return String is
     (Flyology_TLA.Codecs.Encode_Integer (Long_Long_Integer (Item)));

   function Decode_Outcome_Slot
     (Source : String;
      Limits : Flyology_TLA.Traces.Load_Limits) return Outcome_Slot_Type is
      pragma Unreferenced (Limits);
   begin
      return Outcome_Slot_Type (Flyology_TLA.Codecs.Decode_Integer (Source));
   end Decode_Outcome_Slot;

   function Encode_Outcome_Slot (Item : Outcome_Slot_Type) return String is
     (Flyology_TLA.Codecs.Encode_Integer (Long_Long_Integer (Item)));

   function Decode_Outcome_Stamp
     (Source : String;
      Limits : Flyology_TLA.Traces.Load_Limits) return Outcome_Stamp_Type is
      pragma Unreferenced (Limits);
   begin
      return Outcome_Stamp_Type (Flyology_TLA.Codecs.Decode_Integer (Source));
   end Decode_Outcome_Stamp;

   function Encode_Outcome_Stamp (Item : Outcome_Stamp_Type) return String is
     (Flyology_TLA.Codecs.Encode_Integer (Long_Long_Integer (Item)));

   function Decode_Outcome_Epoch
     (Source : String;
      Limits : Flyology_TLA.Traces.Load_Limits) return Outcome_Epoch_Type is
      pragma Unreferenced (Limits);
   begin
      return Outcome_Epoch_Type (Flyology_TLA.Codecs.Decode_Integer (Source));
   end Decode_Outcome_Epoch;

   function Encode_Outcome_Epoch (Item : Outcome_Epoch_Type) return String is
     (Flyology_TLA.Codecs.Encode_Integer (Long_Long_Integer (Item)));

   function Decode_Outcome
     (Source : String;
      Limits : Flyology_TLA.Traces.Load_Limits) return Outcome_Type is
   begin
      if Flyology_TLA.Codecs.Object_Size (Source, Limits) /= 5 then
         raise Flyology_TLA.Codecs.Codec_Error with "unexpected Outcome object shape";
      end if;
      return
        (
         Status => Decode_Outcome_Status
           (Flyology_TLA.Codecs.Object_Member (Source, "status", Limits), Limits),
         Chunk => Decode_Outcome_Chunk
           (Flyology_TLA.Codecs.Object_Member (Source, "chunk", Limits), Limits),
         Slot => Decode_Outcome_Slot
           (Flyology_TLA.Codecs.Object_Member (Source, "slot", Limits), Limits),
         Stamp => Decode_Outcome_Stamp
           (Flyology_TLA.Codecs.Object_Member (Source, "stamp", Limits), Limits),
         Epoch => Decode_Outcome_Epoch
           (Flyology_TLA.Codecs.Object_Member (Source, "epoch", Limits), Limits));
   end Decode_Outcome;

   function Encode_Outcome (Item : Outcome_Type) return String is
   begin
      return
        "{" &
        Flyology_TLA.Codecs.Encode_String ("status") & ":"
        & Encode_Outcome_Status (Item.Status) & "," &
        Flyology_TLA.Codecs.Encode_String ("chunk") & ":"
        & Encode_Outcome_Chunk (Item.Chunk) & "," &
        Flyology_TLA.Codecs.Encode_String ("slot") & ":"
        & Encode_Outcome_Slot (Item.Slot) & "," &
        Flyology_TLA.Codecs.Encode_String ("stamp") & ":"
        & Encode_Outcome_Stamp (Item.Stamp) & "," &
        Flyology_TLA.Codecs.Encode_String ("epoch") & ":"
        & Encode_Outcome_Epoch (Item.Epoch) & "}";
   end Encode_Outcome;

   procedure Run
     (Self   : in out Adapter'Class;
      Trace  : Flyology_TLA.Traces.Trace;
      Limits : Flyology_TLA.Traces.Load_Limits;
      Result : out Flyology_TLA.Replay.Replay_Result)
   is
      use Ada.Strings.Unbounded;
      --  This private bridge is the only JSON-facing adapter layer.
      --  It decodes each command before calling the typed consumer.
      type Bridge is new Flyology_TLA.Replay.Adapter with null record;

      overriding procedure Reset
        (Ignored             : in out Bridge;
         Observed_State_JSON : out Unbounded_String;
         Status              : out Flyology_TLA.Replay.Adapter_Outcome);

      overriding procedure Apply
        (Ignored               : in out Bridge;
         Command               : Flyology_TLA.Replay.Replay_Command;
         Observed_Outcome_JSON : out Unbounded_String;
         Observed_State_JSON   : out Unbounded_String;
         Status                : out Flyology_TLA.Replay.Adapter_Outcome);

      procedure Reset
        (Ignored             : in out Bridge;
         Observed_State_JSON : out Unbounded_String;
         Status              : out Flyology_TLA.Replay.Adapter_Outcome)
      is
         pragma Unreferenced (Ignored);
         Observed : State_Type;
      begin
         Adaptive_Pool_Model.Reset (Self, Observed, Status);
         if Status.Succeeded then
            Observed_State_JSON := To_Unbounded_String (Encode_State (Observed));
         else
            Observed_State_JSON := Null_Unbounded_String;
         end if;
      end Reset;

      procedure Apply
        (Ignored               : in out Bridge;
         Command               : Flyology_TLA.Replay.Replay_Command;
         Observed_Outcome_JSON : out Unbounded_String;
         Observed_State_JSON   : out Unbounded_String;
         Status                : out Flyology_TLA.Replay.Adapter_Outcome)
      is
         pragma Unreferenced (Ignored);
         Typed_Input   : Input_Type;
         Typed_Outcome : Outcome_Type;
         Typed_State   : State_Type;
      begin
         Typed_Input := Decode_Input (To_String (Command.Input_JSON), Limits);
         Adaptive_Pool_Model.Apply
           (Self,
            Command.Index,
            To_String (Command.Action),
            To_String (Command.Role),
            Typed_Input,
            To_String (Command.Model_Source),
            Typed_Outcome,
            Typed_State,
            Status);
         if Status.Succeeded then
            Observed_Outcome_JSON := To_Unbounded_String (Encode_Outcome (Typed_Outcome));
            Observed_State_JSON := To_Unbounded_String (Encode_State (Typed_State));
         else
            Observed_Outcome_JSON := Null_Unbounded_String;
            Observed_State_JSON := Null_Unbounded_String;
         end if;
      exception
         when Error : Flyology_TLA.Codecs.Codec_Error | Constraint_Error =>
            Observed_Outcome_JSON := Null_Unbounded_String;
            Observed_State_JSON := Null_Unbounded_String;
            Status :=
              (Succeeded => False,
               Detail => To_Unbounded_String (Ada.Exceptions.Exception_Message (Error)));
      end Apply;

      Raw : Bridge;
   begin
      Flyology_TLA.Replay.Run (Raw, Trace, Limits, Result);
   end Run;

end Adaptive_Pool_Model;
