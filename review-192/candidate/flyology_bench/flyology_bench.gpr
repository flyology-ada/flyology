project Flyology_Bench is
   type Condition_Test_Hooks_Type is ("false", "true");
   Condition_Test_Hooks : Condition_Test_Hooks_Type :=
     external ("FLYOLOGY_BENCH_CONDITION_TEST_HOOKS", "false");
   Condition_Test_Hook_Source_Dir := "src/test_hooks/conditions/disabled";
   case Condition_Test_Hooks is
      when "false" =>
         null;
      when "true" =>
         Condition_Test_Hook_Source_Dir := "src/test_hooks/conditions/enabled";
   end case;

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "src/native", Condition_Test_Hook_Source_Dir);
   for Library_Name use "flyology_bench";
   for Library_Kind use "static";
   for Library_Dir use "lib";
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O3", "-gnat2022", "-gnatwa", "-gnatwJ", "-gnatVa", "-gnatyM110");
      for Default_Switches ("C") use
        ("-O3", "-std=c11", "-Wall", "-Wextra", "-Werror");
   end Compiler;

   package Linker is
      --  Linux before glibc 2.34 provides the optional dynamic-loader API in
      --  libdl. macOS SDKs retain the compatible library name.
      for Linker_Options use ("-ldl");
   end Linker;

   package Documentation is
      for Resources_Dir ("html") use "../docs/gnatdoc-bench/html";
   end Documentation;

   package Format is
      for Width ("Ada") use "110";
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "2";
      for Indentation_Kind ("Ada") use "spaces";
      for End_Of_Line ("Ada") use "lf";
      for Charset ("Ada") use "utf-8";
   end Format;
end Flyology_Bench;
