with "adaptive_pool_conformance_flyology.gpr";
with "flyology_tla.gpr";

project Adaptive_Pool_Conformance is

   for Languages use ("Ada");
   for Source_Dirs use ("src", "generated");
   for Object_Dir use "build/obj";
   for Exec_Dir use "bin";
   for Main use ("flyology-adaptive_pool_conformance.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwJ", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Builder is
      for Executable ("flyology-adaptive_pool_conformance.adb") use "adaptive-pool-conformance";
   end Builder;

end Adaptive_Pool_Conformance;
