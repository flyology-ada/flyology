project Flyology_Debug_Docs is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Source_Files use
     ("flyology_debug.ads",
      "flyology_debug-gauges.ads",
      "flyology_debug-tracers.ads");
   for Object_Dir use "obj/docs";
   for Create_Missing_Dirs use "True";

   package Documentation is
      for Resources_Dir ("html") use "../docs/gnatdoc-debug/html";
   end Documentation;
end Flyology_Debug_Docs;
