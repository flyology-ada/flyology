with "config/flyology_allocators_atomic_store_config.gpr";
project Flyology_Allocators is

   for Languages use Flyology_Allocators_Atomic_Store_Config.Languages;

   Atomic_Store_Source_Dir := Flyology_Allocators_Atomic_Store_Config.Source_Dir;
   for Source_Dirs use ("src/", Atomic_Store_Source_Dir);
   for Library_Name use "flyology_allocators";
   for Object_Dir use
     external ("FLYOLOGY_ALLOCATORS_OBJECT_DIR", "obj");
   for Create_Missing_Dirs use "True";
   for Library_Dir use
     external ("FLYOLOGY_ALLOCATORS_LIBRARY_DIR", "lib");

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external
       ("FLYOLOGY_ALLOCATORS_LIBRARY_TYPE",
        external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatyM110");
      for Default_Switches ("C") use ("-std=c11", "-Wall", "-Wextra");
   end Compiler;

   package Format is
      for Width ("Ada") use "110";
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "2";
      for Indentation_Kind ("Ada") use "spaces";
      for End_Of_Line ("Ada") use "lf";
      for Charset ("Ada") use "utf-8";
   end Format;

end Flyology_Allocators;
