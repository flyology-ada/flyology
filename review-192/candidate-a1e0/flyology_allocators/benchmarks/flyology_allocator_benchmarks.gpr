with "flyology_allocators";
with "flyology_bench";

project Flyology_Allocator_Benchmarks is
   type Build_Profile_Type is ("development", "release");
   Build_Profile : Build_Profile_Type :=
     external ("FLYOLOGY_ALLOCATOR_BENCH_PROFILE", "release");

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("allocator_benchmark.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      case Build_Profile is
         when "development" =>
            for Default_Switches ("Ada") use
              ("-gnat2022", "-O2", "-gnata", "-gnatwa", "-gnatVa");
         when "release" =>
            for Default_Switches ("Ada") use
              ("-gnat2022", "-O3", "-gnatwa", "-gnatVa");
      end case;
   end Compiler;
end Flyology_Allocator_Benchmarks;

