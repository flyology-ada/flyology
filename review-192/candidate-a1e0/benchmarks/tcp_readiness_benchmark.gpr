with "../flyology.gpr";

project TCP_Readiness_Benchmark is
   for Languages use ("Ada");
   for Runtime ("Ada") use external ("FLYOLOGY_RTS_DIR", "../build/rts");
   for Source_Dirs use (".");
   for Object_Dir use "obj/tcp_readiness";
   for Exec_Dir use "bin";
   for Main use ("tcp_readiness_benchmark.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O3", "-gnatwa", "-gnatwJ");
   end Compiler;
end TCP_Readiness_Benchmark;
