with "config/flyology_config.gpr";
project Flyology is

   type DNS_Test_Hooks_Type is ("false", "true");
   DNS_Test_Hooks : DNS_Test_Hooks_Type :=
     external ("FLYOLOGY_DNS_TEST_HOOKS", "false");
   DNS_Test_Hook_Switch := "-gnateDFLYOLOGY_DNS_TEST_HOOKS=False";
   case DNS_Test_Hooks is
      when "false" =>
         null;
      when "true" =>
         DNS_Test_Hook_Switch := "-gnateDFLYOLOGY_DNS_TEST_HOOKS=True";
   end case;

   type TLS_Test_Hooks_Type is ("false", "true");
   TLS_Test_Hooks : TLS_Test_Hooks_Type :=
     external ("FLYOLOGY_TLS_TEST_HOOKS", "false");
   TLS_Test_Hook_Switch := "-DFLYOLOGY_TLS_TEST_HOOKS=0";
   TLS_Ada_Test_Hook_Switch := "-gnateDFLYOLOGY_TLS_TEST_HOOKS=False";
   case TLS_Test_Hooks is
      when "false" =>
         for Excluded_Source_Files use
           ("flyology-tls_test_hooks.ads",
            "flyology-tls_test_hooks.adb");
      when "true" =>
         TLS_Test_Hook_Switch := "-DFLYOLOGY_TLS_TEST_HOOKS=1";
         TLS_Ada_Test_Hook_Switch := "-gnateDFLYOLOGY_TLS_TEST_HOOKS=True";
   end case;

   type Connection_Test_Hooks_Type is ("false", "true");
   Connection_Test_Hooks : Connection_Test_Hooks_Type :=
     external ("FLYOLOGY_CONNECTION_TEST_HOOKS", "false");
   Connection_Test_Hook_Switch :=
     "-gnateDFLYOLOGY_CONNECTION_TEST_HOOKS=False";
   case Connection_Test_Hooks is
      when "false" =>
         null;
      when "true" =>
         Connection_Test_Hook_Switch :=
           "-gnateDFLYOLOGY_CONNECTION_TEST_HOOKS=True";
   end case;

   type Worker_Pool_Test_Hooks_Type is ("false", "true");
   Worker_Pool_Test_Hooks : Worker_Pool_Test_Hooks_Type :=
     external ("FLYOLOGY_WORKER_POOL_TEST_HOOKS", "false");
   Worker_Pool_Test_Hook_Switch :=
     "-gnateDFLYOLOGY_WORKER_POOL_TEST_HOOKS=False";
   case Worker_Pool_Test_Hooks is
      when "false" =>
         null;
      when "true" =>
         Worker_Pool_Test_Hook_Switch :=
           "-gnateDFLYOLOGY_WORKER_POOL_TEST_HOOKS=True";
   end case;

   type Structured_Server_Test_Hooks_Type is ("false", "true");
   Structured_Server_Test_Hooks : Structured_Server_Test_Hooks_Type :=
     external ("FLYOLOGY_STRUCTURED_SERVER_TEST_HOOKS", "false");
   Structured_Server_Test_Hook_Switch :=
     "-gnateDFLYOLOGY_STRUCTURED_SERVER_TEST_HOOKS=False";
   case Structured_Server_Test_Hooks is
      when "false" =>
         null;
      when "true" =>
         Structured_Server_Test_Hook_Switch :=
           "-gnateDFLYOLOGY_STRUCTURED_SERVER_TEST_HOOKS=True";
   end case;

   type Wall_Clock_Test_Hooks_Type is ("false", "true");
   Wall_Clock_Test_Hooks : Wall_Clock_Test_Hooks_Type :=
     external ("FLYOLOGY_WALL_CLOCK_TEST_HOOKS", "false");
   Wall_Clock_Test_Hook_Switch :=
     "-gnateDFLYOLOGY_WALL_CLOCK_TEST_HOOKS=False";
   case Wall_Clock_Test_Hooks is
      when "false" =>
         null;
      when "true" =>
         Wall_Clock_Test_Hook_Switch :=
           "-gnateDFLYOLOGY_WALL_CLOCK_TEST_HOOKS=True";
   end case;

   for Languages use ("Ada", "C");

   for Library_Name use "Flyology";

   case Flyology_Config.Alire_Host_OS is
      when "linux" =>
         for Source_Dirs use
           ("src/", "src/native/", "src/platform/linux/", "config/");
      when "macos" =>
         for Source_Dirs use
           ("src/", "src/native/", "src/platform/darwin/", "config/");
      when others =>
         for Source_Dirs use ("src/", "src/native/", "config/");
   end case;

   type Documentation_Mode_Type is ("false", "true");
   Documentation_Mode : Documentation_Mode_Type :=
     external ("FLYOLOGY_DOCUMENTATION", "false");
   case Documentation_Mode is
      when "false" =>
         null;
      when "true" =>
         for Languages use ("Ada");
         --  Public API plus private specs needed to resolve its dependencies.
         --  Private proof helpers exclude themselves from generated docs.
         for Source_Files use
           ("flyology.ads",
            "flyology-capacity.ads",
            "flyology-bounded_channels.ads",
            "flyology-buffers.ads",
            "flyology-buffers-channels.ads",
            "flyology-bytes.ads",
            "flyology-cancellation.ads",
            "flyology-channels.ads",
            "flyology-channels-bounded.ads",
            "flyology-data_structures.ads",
            "flyology-data_structures-allocation_algorithms.ads",
            "flyology-data_structures-allocation_algorithms-best_fit.ads",
            "flyology-data_structures-allocation_algorithms-best_fit_kernel.ads",
            "flyology-data_structures-allocation_algorithms-buddy.ads",
            "flyology-data_structures-allocation_algorithms-buddy_kernel.ads",
            "flyology-data_structures-allocation_algorithms-contract.ads",
            "flyology-data_structures-allocation_algorithms-tlsf.ads",
            "flyology-data_structures-allocation_algorithms-tlsf_kernel.ads",
            "flyology-data_structures-allocation_pools.ads",
            "flyology-data_structures-allocation_pools-adaptive.ads",
            "flyology-data_structures-arenas.ads",
            "flyology-data_structures-byte_strings.ads",
            "flyology-data_structures-dynamic.ads",
            "flyology-data_structures-dynamic-byte_strings.ads",
            "flyology-data_structures-dynamic-hash_maps.ads",
            "flyology-data_structures-dynamic-vectors.ads",
            "flyology-data_structures-envelopes.ads",
            "flyology-data_structures-handles.ads",
            "flyology-data_structures-hash_maps.ads",
            "flyology-data_structures-layouts.ads",
            "flyology-data_structures-regions.ads",
            "flyology-data_structures-rings.ads",
            "flyology-data_structures-rings-mpmc.ads",
            "flyology-data_structures-rings-spsc.ads",
            "flyology-data_structures-slab_pools.ads",
            "flyology-data_structures-storage_types.ads",
            "flyology-data_structures-storage_types-elements.ads",
            "flyology-data_structures-storage_types-immutable.ads",
            "flyology-data_structures-storage_types-unsigned_64s.ads",
            "flyology-data_structures-vectors.ads",
            "flyology-dormancy.ads",
            "flyology-execution_groups.ads",
            "flyology-execution_groups-topology.ads",
            "flyology-fairness.ads",
            "flyology-io.ads",
            "flyology-io-connections.ads",
            "flyology-io-connections-drivers.ads",
            "flyology-io-connections-tls.ads",
            "flyology-io-dns.ads",
            "flyology-io-dns-testing.ads",
            "flyology-io-files.ads",
            "flyology-io-files-transfers.ads",
            "flyology-io-sockets.ads",
            "flyology-structured_server_policy.ads",
            "flyology-io-structured_servers.ads",
            "flyology-io-tls.ads",
            "flyology-io-tls-alpn.ads",
            "flyology-io-tls-openssl.ads",
            "flyology-io-timers.ads",
            "flyology-timer_set_policy.ads",
            "flyology-memory_regions.ads",
            "flyology-observability.ads",
            "flyology-observability-stall_watchdogs.ads",
             "flyology-native_executor_policy.ads",
             "flyology-native_executors.ads",
             "flyology-process_lifecycle.ads",
            "flyology-supervision.ads",
            "flyology-supervision-children.ads",
            "flyology-supervision-adapters.ads",
            "flyology-supervision-families.ads",
            "flyology-supervision-input_task_generations.ads",
            "flyology-supervision-input_children.ads",
            "flyology-supervision-service_slots.ads",
            "flyology-supervision-static.ads",
            "flyology-supervision-task_generations.ads",
             "flyology-task_scopes.ads",
             "flyology-task_results.ads",
             "flyology-wake_sources.ads",
             "flyology-worker_pools.ads");
   end case;
   for Object_Dir use "obj/" & Flyology_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("FLYOLOGY_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Config.Ada_Compiler_Switches
        & ("-gnatwJ", DNS_Test_Hook_Switch, Connection_Test_Hook_Switch,
           Worker_Pool_Test_Hook_Switch, Structured_Server_Test_Hook_Switch,
           Wall_Clock_Test_Hook_Switch, TLS_Ada_Test_Hook_Switch);
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", TLS_Test_Hook_Switch);
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      case Flyology_Config.Alire_Host_OS is
         when "linux" =>
            --  Keep compatibility with glibc releases where the dynamic
            --  loader API is still provided by a separate libdl.
            for Linker_Options use ("-ldl");
         when others =>
            null;
      end case;
   end Linker;

   package Documentation is
      for Excluded_Project_Files use ("config/flyology_config.gpr");
      for Resources_Dir ("html") use "docs/gnatdoc/html";
   end Documentation;

end Flyology;
