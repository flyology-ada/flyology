with "config/gnatevl_config.gpr";
project Gnatevl is

   for Languages use ("Ada");

   for Library_Name use "Gnatevl";
   for Library_Version use Project'Library_Name & ".so." & Gnatevl_Config.Crate_Version;

   case Gnatevl_Config.Alire_Host_OS is
      when "linux" =>
         for Source_Dirs use ("src/", "src/platform/linux/", "config/");
      when others =>
         for Source_Dirs use ("src/", "src/platform/darwin/", "config/");
   end case;
   for Object_Dir use "obj/" & Gnatevl_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("GNATEVL_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Gnatevl_Config.Ada_Compiler_Switches & ("-gnatwJ");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Gnatevl;
